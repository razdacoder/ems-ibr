# Django as this server reaches it (SSR fetches of branding + feature content).
API_URL=http://localhost:8000
# Django as the browser reaches it (REST + WebSockets). In production this
# defaults to https://api.<site host>.
PUBLIC_API_URL=http://localhost:8000
# The marketing site (separate repo, runs on :3001). Optional.
SITE_URL=http://localhost:3001
