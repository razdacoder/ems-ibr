# Django as this server reaches it (the server side branding fetch, sent
# with the browser's Host so Django knows the school).
API_URL=http://localhost:8000
# Schools live at <slug>.localhost:3000, the console at admin.localhost:3000.
# The browser calls Django on its own origin through the Vite proxy.
PLATFORM_BASE_DOMAIN=localhost
# The marketing site (separate repo, runs on :3001). Optional.
SITE_URL=http://localhost:3001
